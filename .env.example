# 1) Gemini key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=          # optional: second key (another Google project), used if the first runs out of quota
# 2) Telegram API id/hash for the AI's account (free): https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# 3) Who the AI calls: your Telegram user id (digits) or @username
OWNER=@your_username
OWNER_NAME=boss
ASSISTANT_NAME=Jarvis

# Voice and language
LANGUAGE=en            # en, th, ja, zh, ko, vi, id, es, fr, de, pt, hi ...
VOICE=Charon           # Charon, Puck, Kore, Fenrir, Aoede, Orus, Leda, Zephyr ...
LIVE_MODEL=gemini-3.1-flash-live-preview
TEXT_MODEL=gemini-flash-latest

# Manners
QUIET_HOURS=22:00-07:00   # no calls in this window (except urgent webhook calls); "off" to disable
MAX_CALLS_PER_DAY=6
RETRY_NO_ANSWER=1         # call again if you don't pick up
RETRY_AFTER_MIN=3
MAX_CALL_MINUTES=20
CAMERA=on                 # let the AI see your camera / screen share during calls (needs opencv)

# Optional webhook so other apps can make the AI call you. Empty token = off.
WEBHOOK_TOKEN=
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8787

# Public demo line: let anyone call the AI (strict limits, no tools, never reveals private info).
# Use a SEPARATE Telegram account for this, never your private assistant's account.
PUBLIC_MODE=off
PUBLIC_MAX_MINUTES=3
PUBLIC_CALLS_PER_CALLER=2
PUBLIC_CALLS_PER_DAY=40
